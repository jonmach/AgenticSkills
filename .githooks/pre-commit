#!/usr/bin/env bash
# Fail the commit if the skill has drifted from its checks.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only | grep -q '^skills/critical-lens/'; then
  exit 0
fi

echo "running critical-lens checks..."
"$repo_root/skills/critical-lens/scripts/check.sh" "$repo_root/skills/critical-lens"
